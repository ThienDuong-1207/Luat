POSTGRES_URL=postgresql+psycopg://luatgt:luatgt@localhost:5432/luatgt
# Nếu máy đã có Postgres chiếm cổng 5432: đặt POSTGRES_PORT=5433 và sửa cổng trong POSTGRES_URL
# POSTGRES_PORT=5433
MINIO_ENDPOINT=http://localhost:9000
# Giá trị mặc định chỉ dùng cho môi trường dev local
MINIO_ACCESS_KEY=luatgt
MINIO_SECRET_KEY=luatgt-dev-secret
LLM_PROVIDER=anthropic          # anthropic | openai | local
LLM_MODEL=
LLM_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
CRAWL_MIN_DELAY_S=3
CRAWL_MAX_DELAY_S=6
TZ=Asia/Ho_Chi_Minh
LOG_LEVEL=INFO

# Spark 4 cần Java 17 hoặc 21 (macOS: /usr/libexec/java_home -V để xem các bản đã cài)
# JAVA_HOME=/Library/Java/JavaVirtualMachines/jdk-21.jdk/Contents/Home
